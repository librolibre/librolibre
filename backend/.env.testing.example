# Copia este fichero como .env.testing (no se sube a Git).
# php artisan test usa esta base de datos LOCAL; RefreshDatabase la vacía en cada test.
# Nunca pongas aquí los datos de Neon.
APP_ENV=testing
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=tu_usuario_de_postgres
DB_PASSWORD=
